# Bitwarden API Credentials
# Copy this file to .env.bitwarden and fill in your actual values
# Get these from: https://vault.bitwarden.com → Settings → Security → API Key

BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
BW_PASSWORD=your-master-password-here


# Variables consumed by compose/docker-compose.yml interpolation.
# This file documents the variable shape only; it is not loaded by any tool.
#
# At runtime, `docker compose` (invoked from this directory) auto-loads
# compose/.env, which is rendered by chezmoi from
# .secrets/compose/dot_env.tmpl based on the laptop's mode.
#
# Terraform reads compose/.env.prod (always production-shaped, regardless
# of laptop mode) via the germanbrew/dotenv provider when rendering the
# compose template into a dokploy_compose resource.

# --- Required ---

# Routing host suffix used by Traefik labels in docker-compose.yml.
# Local mode renders this as `docker.localhost` (resolves to 127.0.0.1
# without DNS/hosts setup for the *.docker.localhost wildcard). Production
# mode renders this as the real TLD (e.g. symbionic.tech). Locally there
# is no Traefik, so the value is metadata-only — services are reached via
# the override file's port mappings on http://localhost:<port>.
HOSTNAME_TLD=

# Image tag for the astarte service. In dev this just needs to be set
# (any non-empty value) so compose doesn't warn; the override targets
# astarte:dev directly via the Dockerfile's `dev` stage. In prod,
# Terraform substitutes this with the git SHA being deployed via
# templatefile() — the value in this .env is ignored on the prod path.
ASTARTE_IMAGE_TAG=local

# GHCR org/user the published images live under. The chezmoi template
# fills this from `gh api user --jq .login` at apply time, so forks
# pick up their own owner automatically. Production TF reads this via
# the dotenv provider and feeds it into the compose templatefile().
GHCR_OWNER=

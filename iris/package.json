{
  "name": "iris",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "format": "biome format --write .",
    "lint": "biome check",
    "prepare": "panda codegen",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc",
    "typegen:api": "openapi-typescript ../astarte/openapi.json -o app/generated/api.d.ts",
    "typegen:db": "drizzle-kit pull && rm -rf app/generated/meta app/generated/0000_*.sql"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.2",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "8.4.0",
    "remix-i18next": "^7.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@pandacss/dev": "^1.11.3",
    "@park-ui/panda-preset": "^0.43.1",
    "@react-router/dev": "8.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.9"
  }
}

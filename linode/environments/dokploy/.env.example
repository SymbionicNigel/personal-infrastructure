# Populated automatically by scripts/deploy-production.sh after Stage 1.
# Do not commit real values; this file is encrypted into .secrets/ via chezmoi.

TF_VAR_DOKPLOY_API_KEY=<retrieved-from-cloud-init>
TF_VAR_HOSTNAME_TLD=<your.tld>

# Image tag for the astarte service. CI sets this to the git SHA being
# deployed. For local applies (or first bootstrap), 'latest' is fine.
TF_VAR_ASTARTE_IMAGE_TAG=latest

# S3 backend credentials (Linode Object Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

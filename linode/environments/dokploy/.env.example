# Populated automatically by linode/environments/production/production.sh after
# Stage 1 (Dokploy API key + the five DOKPLOY_BACKUP_* values come from
# `terraform output`). TF_VAR_GHCR_PAT is the one entry that must be added
# manually via chezmoi -- it is not surfaced by any flow.
# Do not commit real values; this file is encrypted into .secrets/ via chezmoi.

TF_VAR_DOKPLOY_API_KEY=<retrieved-from-cloud-init>

# S3 backend credentials (Linode Object Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Shared infra-backups bucket creds used by dokploy_backup_destination.
TF_VAR_DOKPLOY_BACKUP_BUCKET=
TF_VAR_DOKPLOY_BACKUP_ENDPOINT=
TF_VAR_DOKPLOY_BACKUP_REGION=
TF_VAR_DOKPLOY_BACKUP_ACCESS_KEY_ID=
TF_VAR_DOKPLOY_BACKUP_SECRET_ACCESS_KEY=

# Fine-grained GitHub PAT (Packages: Read-only). Consumed by
# terraform_data.ghcr_registry to register the host's docker login with Dokploy.
TF_VAR_GHCR_PAT=

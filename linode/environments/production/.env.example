# Stage 1 (production) variables. Real values live in .secrets/ via chezmoi.

TF_VAR_LINODE_TOKEN=
TF_VAR_DOKPLOY_ADMIN_EMAIL=
TF_VAR_DOKPLOY_ADMIN_PASSWORD=
TF_VAR_HOSTNAME_TLD=
TF_VAR_EMAIL_ADDRESS=
TF_VAR_REGION=

# S3 backend credentials (Linode Object Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GPG recipient (id/fingerprint/email) used to encrypt acme.json backups.
# Public key must be present in the deploy machine's gpg keyring.
TF_VAR_GPG_RECIPIENT=

# GHCR pull PAT for the Dokploy host (fine-grained, Packages: Read-only).
TF_VAR_GHCR_PAT=

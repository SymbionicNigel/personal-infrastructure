{
    "yaml.schemas": {
        "./.vscode/empty.schema.json": [
            "**/.github/actions/**/action.yml",
            "**/.github/workflows/*.yml",
            "**/.github/workflows/*.yaml",
            "**/pnpm-workspace.yaml"
        ]
    },
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "eslint.enable": true,
    "files.associations": {
        ".env.*": "dotenv",
        ".env": "dotenv"
    },
    "better-todo-tree.tree.disableCompactFolders": true,
    "better-todo-tree.tree.showCountsInTree": true,
}